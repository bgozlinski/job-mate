# Copy to .env and fill in the values. .env is git-ignored; this file is not,
# so never put real credentials here.
#
# Only the names below are accepted: a key here that carries a value and is
# not one of them (a typo, a leftover) aborts startup with a message naming
# it. The check covers this file only -- an unknown environment variable, or
# a key left empty below, passes unnoticed. See Settings in app/core/config.py.

# Database. POSTGRES_HOST/PORT are the values used when running outside Docker;
# docker-compose overrides them with the `db` service address.
POSTGRES_DB=jobmate
POSTGRES_USER=jobmate
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache. Overridden by docker-compose to point at the `redis` service.
REDIS_URL=redis://localhost:6379/0

# Embeddings. The key is only needed to ingest documents; the rest of the
# application starts without it. The model must return 1536 dimensions --
# the width of chunks.embedding and of the HNSW index.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# LLM. Only needed to generate resume suggestions (FR-3); everything else
# starts without it. The model only rephrases bullet points -- the score and the
# gaps are computed in Python -- so the cheapest tier is the right default.
# Heavier alternatives, in order: claude-sonnet-5, claude-opus-5.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Auth. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Cost control (NFR-2). Per account, per window, on the two routes that spend
# money at a provider. Matching gets the tighter budget: it pays for an LLM
# call on top of its embeddings. Two counters rather than one, so an afternoon
# of filling the knowledge base cannot lock a user out of matching.
MATCH_RATE_LIMIT=20
INGEST_RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=3600

# Observability (NFR-2). Traces of every LLM call: prompt, response, token
# cost, latency, retrieved chunks. The two keys are the project keys created
# by the self-hosted Langfuse on first start -- copy them from
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY in .env.langfuse. Without
# them the SDK stays quiet and the application runs unchanged, which is what
# CI relies on.
#
# LANGFUSE_HOST is the compose service address. Use http://localhost:3000
# only when running the API outside Docker.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000
