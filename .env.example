# Copy to .env and fill in the values. .env is git-ignored; this file is not,
# so never put real credentials here.
#
# Only the names below are accepted: a key here that carries a value and is
# not one of them (a typo, a leftover) aborts startup with a message naming
# it. The check covers this file only -- an unknown environment variable, or
# a key left empty below, passes unnoticed. See Settings in app/core/config.py.

# Database. POSTGRES_HOST/PORT are the values used when running outside Docker;
# docker-compose overrides them with the `db` service address.
POSTGRES_DB=jobmate
POSTGRES_USER=jobmate
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Cache. Overridden by docker-compose to point at the `redis` service.
REDIS_URL=redis://localhost:6379/0

# Embeddings. The key is only needed to ingest documents; the rest of the
# application starts without it. The model must return 1536 dimensions --
# the width of chunks.embedding and of the HNSW index.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# LLM. Only needed to generate resume suggestions (FR-3); everything else
# starts without it. The model only rephrases bullet points -- the score and the
# gaps are computed in Python -- so the cheapest tier is the right default.
# Heavier alternatives, in order: claude-sonnet-5, claude-opus-5.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5

# Auth. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Session lifetimes. Two of them for one kind of token, because the two clients
# differ in what they can do about expiry. ACCESS_TOKEN_EXPIRE_MINUTES is the
# token returned in the login response and used with an Authorization header;
# the Streamlit client holds it and cannot renew it, so it is long.
# COOKIE_ACCESS_EXPIRE_MINUTES is the same credential in an httpOnly cookie,
# which a browser renews at /auth/refresh without the user noticing, so it is
# short. REFRESH_TOKEN_EXPIRE_DAYS is how long that renewing may go on before
# the password is asked for again.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_ACCESS_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Whether the auth cookies carry the Secure flag. false for local development
# over http, true anywhere reached over https -- and there is no setting that
# is right in both. Secure over plain http makes the browser drop the cookie
# silently, which looks exactly like a broken login.
COOKIE_SECURE=false

# The path prefix the browser reaches this API under. Empty when it is called
# at its own root, which is what the Streamlit client and the tests do.
# docker-compose sets it to /api for the api service, because the web client
# is served from one origin with a proxy that routes /api/* here.
#
# It matters because a cookie's Path is matched against the URL in the address
# bar, not against the path this process saw. Get it wrong and the refresh
# cookie is written for a path the browser never requests, so it is never sent
# back and every renewal answers 401 -- exactly like an expired session.
COOKIE_PATH_PREFIX=

# Cost control (NFR-2). Per account, per window, on the two routes that spend
# money at a provider. Matching gets the tighter budget: it pays for an LLM
# call on top of its embeddings. Two counters rather than one, so an afternoon
# of filling the knowledge base cannot lock a user out of matching.
MATCH_RATE_LIMIT=20
INGEST_RATE_LIMIT=60
RATE_LIMIT_WINDOW_SECONDS=3600

# Reading a posting from its URL (FR-1, NFR-5). The list is closed: only these
# hosts are ever fetched. It is both the legal record -- a host is added after
# someone checked its robots.txt and terms, see the NFR-5 change of 2026-09-07
# -- and the defence against a caller pointing the server at Postgres, Redis,
# Langfuse or the cloud metadata endpoint next door on the Docker network.
#
# A list, so this must be JSON, not a comma separated string:
#   SCRAPER_ALLOWED_HOSTS=["justjoin.it","pracuj.pl"]
# The host is matched whole, so a subdomain has to be listed by name.
SCRAPER_ALLOWED_HOSTS=["justjoin.it"]
SCRAPER_TIMEOUT_SECONDS=10.0
SCRAPER_MAX_BYTES=2097152
SCRAPER_MAX_REDIRECTS=3

# Observability (NFR-2). Traces of every LLM call: prompt, response, token
# cost, latency, retrieved chunks. The two keys are the project keys created
# by the self-hosted Langfuse on first start -- copy them from
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY in .env.langfuse. Without
# them the SDK stays quiet and the application runs unchanged, which is what
# CI relies on.
#
# LANGFUSE_HOST is the compose service address. Use http://localhost:3000
# only when running the API outside Docker.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000
