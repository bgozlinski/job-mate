        "title": "MatchCreate",
        "type": "object"
      },
      "MatchRead": {
        "description": "The result of one match.\n\nretrieved_chunk_ids is part of the response, not an internal detail: the\ncaller is told which fragments the suggestions were built from, so an\nanswer can be checked against what the model actually saw.\n\nsuggestions is text for the resume; notes is what the model has to say\nabout the resume. Two fields, because a client that renders one list\nwould otherwise render a remark about a missing skill as a line of the\ndocument itself.\n\nmatched_evidence carries, for a requirement an LLM judged met, the words\nof the resume it quoted. Empty for a match the deterministic rule made --\nthe term is then literally in the text -- and empty everywhere when no\njudge is configured. It is what lets a candidate disagree with a match.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "document_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "document_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Title"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "matched_evidence": {
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "title": "Matched Evidence",
            "type": "object"
          },
          "matched_keywords": {
            "items": {
              "type": "string"
            },
            "title": "Matched Keywords",
            "type": "array"
          },
          "missing_keywords": {
            "items": {
              "type": "string"
            },
            "title": "Missing Keywords",
            "type": "array"
          },
          "notes": {
            "items": {
              "type": "string"
            },
            "title": "Notes",
            "type": "array"
          },
          "resume_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Id"
          },
          "retrieved_chunk_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Retrieved Chunk Ids",
            "type": "array"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "suggestions": {
            "items": {
              "type": "string"
            },
            "title": "Suggestions",
            "type": "array"
          }
        },
