  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Answer at the root so a bare request confirms the app is serving.",
        "operationId": "root__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Root  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Root"
      }
    },
    "/auth/login": {
      "post": {
        "description": "Exchange credentials for a session, in both shapes at once.\n\nThe body carries a long-lived token for a client that sends an\nAuthorization header and cannot renew what it holds. The same response\nsets httpOnly cookies for a browser, which can renew silently and so\ngets a short access cookie backed by a refresh token. Both are issued\nevery time: which one a client uses is the client's business, and a\nlogin that had to be told in advance would need a flag nobody wants to\nexplain.\n\nA browser is handed a token in the body it will not use. That is the\nprice of one login route for two clients, and it is not a leak: the\nresponse goes to a caller who just proved they own the account, over the\nsame connection as the cookies.\n\nAn unknown address and a wrong password produce the same response and,\nthanks to the discarded verification, take the same time. Either one\nwould otherwise reveal which addresses have accounts (NFR-1).",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "End the browser's session by removing both cookies.\n\nNo authentication required, on purpose. A session whose access cookie\nhas already expired is exactly the one a user wants to end, and a logout\nthat answered 401 would refuse at the moment it is most needed. Nothing\nis destroyed that the caller does not already hold, so there is nothing\nto protect here.\n\nAnswering the same way whether or not there was a session keeps this\nfrom reporting whether the caller was logged in.",
        "operationId": "logout_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "description": "Return the account behind the token.",
        "operationId": "read_current_user_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Read Current User",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Renew the short access cookie from the refresh cookie.\n\nCookie only: the refresh token is never handed out any other way, so\nthere is no header to read it from, and accepting one would widen the\nsurface for nothing. The Bearer client does not come here at all -- it\nholds a long-lived token and has no refresh cookie to present.\n\nThe account is loaded rather than trusted from the claims, so a deleted\naccount cannot renew its way through the rest of the week. That database\nread is the only thing standing between a deleted user and a working\nsession, since nothing revokes the tokens themselves.\n\nEvery failure is the same 401 as anywhere else: no cookie, a bad\nsignature, an expired token, an access token presented as a refresh one,\nan account that is gone. The cookies are deliberately left in place on\nfailure -- clearing them would mean building the error response by hand,\nand a dead refresh cookie is inert anyway. A 401 here means the caller\nhas to log in again, not retry.",
        "operationId": "refresh_auth_refresh_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register": {
      "post": {
        "description": "Create an account, or answer 409 if the address is taken.\n\nThe duplicate is caught from the unique index rather than prevented by a\nprior SELECT: checking first leaves a window in which a concurrent\nrequest can insert the same address between the check and the write.",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/documents": {
      "get": {
        "description": "List the knowledge base, newest first.\n\nFR-3 has the user pick the posting to be matched against, and until this\nroute existed the only way to learn a document_id was to send the same\ntext again and read it off the deduplicated answer. Formally the listing\nbelongs to administration (FR-6); practically FR-3 is unusable without\nit, so it is here and open to any authenticated account, exactly like\ningestion. Deleting is what stays with an admin.\n\nThe content is not in the response -- DocumentRead leaves it out -- so a\npage stays small no matter how long the postings are.\n\nOrdering is by created_at and then by id, because two sources ingested in\nthe same moment would otherwise have no defined order and offset paging\ncould show one of them twice. Ids are uuid7, so the tiebreaker runs the\nsame way as time.\n\nThe caller pages until a short page comes back; no total is returned,\nwhich would cost a second count query on every request to tell them\nsomething the next call tells them for free.",
        "operationId": "list_documents_documents_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentRead"
                  },
                  "title": "Response List Documents Documents Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Documents",
        "tags": [
          "documents"
        ]
      },
      "post": {
        "description": "Ingest a source, or return the one it duplicates.\n\nAny authenticated account may add to the knowledge base: FR-1 describes\na user pasting the posting they want to be matched against, and FR-3\nthen has them pick it. Administration -- browsing and deleting sources\n(FR-6) -- is what stays with an admin.\n\nA duplicate answers 200 with the document that was already there rather\nthan 409: the caller's intent, having this text in the knowledge base,\nis satisfied, and the body tells them which document it is.\n\nThe route is rate limited (NFR-2): it spends money at a third-party API.",
        "operationId": "create_document_documents_post",
        "requestBody": {
          "content": {
