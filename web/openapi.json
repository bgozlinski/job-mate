      "DocumentCreate": {
        "description": "Payload for ingesting one job posting.\n\nmetadata is left as an open object on purpose: it is what hybrid\nretrieval filters on (role, seniority), and the knowledge base has to be\nable to carry keys the API does not know about yet.",
        "properties": {
          "content": {
            "maxLength": 200000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "source_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "content"
        ],
        "title": "DocumentCreate",
        "type": "object"
      },
      "DocumentFromUrl": {
        "description": "Payload for ingesting the posting published at an address (FR-1).\n\nNo content and no title: both are read off the page. Which addresses are\nread at all is a question of policy, answered by the allowlist in\nSettings rather than by this schema -- HttpUrl only proves the string is\na URL, and http://169.254.169.254/ is a perfectly good one (NFR-1).\n\nmetadata is here for the same reason the other two routes have it: to\nlabel a posting with the role or seniority a listing is filtered by. What\nthe caller supplies wins over what was scraped, because a caller who\nbothers to send a key means to correct what the page said.",
        "properties": {
          "metadata": {
            "additionalProperties": true,
            "title": "Metadata",
            "type": "object"
          },
          "url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "DocumentFromUrl",
        "type": "object"
      },
