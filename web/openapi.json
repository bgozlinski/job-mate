    "/resumes/{resume_id}/match": {
      "post": {
        "description": "Score one of the caller's resumes against a posting and suggest edits.\n\nThe answer is stored before it is returned, and the stored row is what\ncomes back: the response and the history are then the same object, and a\nreader comparing the two later cannot find them disagreeing.\n\nThe resume comes from a dependency that filters by owner, so a resume\nbelonging to somebody else is a 404 here exactly as a missing one is: a\ndifferent answer would confirm it exists (NFR-1).\n\nThis is the most expensive route in the application -- it calls an LLM --\nwhich is why it carries the tighter of the two rate limits (NFR-2).",
        "operationId": "match_resumes__resume_id__match_post",
        "parameters": [
          {
            "in": "path",
            "name": "resume_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Resume Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
