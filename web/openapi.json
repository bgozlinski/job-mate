    },
    "/auth/login": {
      "post": {
        "description": "Exchange credentials for a session, in both shapes at once.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
