          "id",
          "document_id",
          "created_at",
          "score",
          "matched_keywords",
          "missing_keywords",
          "suggestions",
          "notes",
          "retrieved_chunk_ids"
        ],
        "title": "MatchRead",
        "type": "object"
      },
      "MatchSummary": {
        "description": "One row of the history: enough to choose which match to open.\n\nThe lists are left out and counted instead. A history is read to find\nsomething, and a page of it should not carry every suggestion ever\nwritten for every posting.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "document_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "document_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Title"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "matched_count": {
            "title": "Matched Count",
            "type": "integer"
          },
          "missing_count": {
            "title": "Missing Count",
            "type": "integer"
          },
          "resume_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resume Id"
          },
          "score": {
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "id",
          "document_id",
          "document_title",
          "resume_id",
          "score",
          "matched_count",
          "missing_count",
          "created_at"
        ],
        "title": "MatchSummary",
        "type": "object"
      },
